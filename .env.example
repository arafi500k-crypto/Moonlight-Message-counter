# GEMINI_API_KEY: Required for Gemini AI API calls if AI features are added.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase Cloud Function Webhook Secret (configure via `firebase functions:secrets:set MOONLIGHT_WEBHOOK_SECRET`)
MOONLIGHT_WEBHOOK_SECRET="MY_MOONLIGHT_WEBHOOK_SECRET"
